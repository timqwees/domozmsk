        'object' => '{"id":null,"source":0,"property_preprocess":0,"name":"modDevTools","description":"Rapid site development helper for MODx Revolution","editor_type":0,"category":0,"cache_type":0,"plugincode":"\\/**\\n * modDevTools Plugin\\n *\\n * @package moddevtools\\n * @subpackage plugin\\n *\\n * @var modX $modx\\n * @var array $scriptProperties\\n *\\/\\n\\n$className = \'TreehillStudio\\\\ModDevTools\\\\Plugins\\\\Events\\\\\\\\\' . $modx->event->name;\\n\\n$corePath = $modx->getOption(\'moddevtools.core_path\', null, $modx->getOption(\'core_path\') . \'components\\/moddevtools\\/\');\\n\\/** @var modDevTools $moddevtools *\\/\\n$moddevtools = $modx->getService(\'moddevtools\', \'modDevTools\', $corePath . \'model\\/moddevtools\\/\', [\\n    \'core_path\' => $corePath\\n]);\\n\\nif ($moddevtools) {\\n    if (class_exists($className)) {\\n        $handler = new $className($modx, $scriptProperties);\\n        if (get_class($handler) == $className) {\\n            $handler->run();\\n        } else {\\n            $modx->log(xPDO::LOG_LEVEL_ERROR, $className. \' could not be initialized!\', \'\', \'modDevTools Plugin\');\\n        }\\n    } else {\\n        $modx->log(xPDO::LOG_LEVEL_ERROR, $className. \' was not found!\', \'\', \'modDevTools Plugin\');\\n    }\\n}\\n\\nreturn;","locked":0,"properties":"a:0:{}","disabled":0,"moduleguid":"","static":0,"static_file":"","content":"\\/**\\n * modDevTools Plugin\\n *\\n * @package moddevtools\\n * @subpackage plugin\\n *\\n * @var modX $modx\\n * @var array $scriptProperties\\n *\\/\\n\\n$className = \'TreehillStudio\\\\ModDevTools\\\\Plugins\\\\Events\\\\\\\\\' . $modx->event->name;\\n\\n$corePath = $modx->getOption(\'moddevtools.core_path\', null, $modx->getOption(\'core_path\') . \'components\\/moddevtools\\/\');\\n\\/** @var modDevTools $moddevtools *\\/\\n$moddevtools = $modx->getService(\'moddevtools\', \'modDevTools\', $corePath . \'model\\/moddevtools\\/\', [\\n    \'core_path\' => $corePath\\n]);\\n\\nif ($moddevtools) {\\n    if (class_exists($className)) {\\n        $handler = new $className($modx, $scriptProperties);\\n        if (get_class($handler) == $className) {\\n            $handler->run();\\n        } else {\\n            $modx->log(xPDO::LOG_LEVEL_ERROR, $className. \' could not be initialized!\', \'\', \'modDevTools Plugin\');\\n        }\\n    } else {\\n        $modx->log(xPDO::LOG_LEVEL_ERROR, $className. \' was not found!\', \'\', \'modDevTools Plugin\');\\n    }\\n}\\n\\nreturn;"}',
